# Demo runs without external services. Copy this file to .env.local for development.
APP_URL=http://localhost:3000
# Credentials below are ONLY for the localhost development compose stack.
DATABASE_URL=postgresql://hamyar:hamyar_local_only@localhost:5432/hamyar
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Future production integrations: generate a unique random auth secret (>=32 bytes).
AUTH_SECRET=
# Recording worker will use private S3-compatible object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
