# Real workspace requires configured identity and Postgres. Preserve existing .env.local.
# Legacy UI regression only: HAMYAR_LOCAL_DEMOS=1 with local NODE_ENV=development.
APP_URL=http://localhost:3000
# Credentials below are ONLY for the localhost development compose stack.
DATABASE_URL=postgresql://hamyar_app:hamyar_local_only@localhost:5432/hamyar
MIGRATION_DATABASE_URL=postgresql://hamyar:hamyar_local_only@localhost:5432/hamyar
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Default true. Temporary password-only signup: false; never verifies email ownership.
AUTH_EMAIL_VERIFICATION_REQUIRED=true
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
HAMYAR_DEPLOYMENT_MODE=normal
HAMYAR_DOMESTIC_HOSTS=postgres,localhost,127.0.0.1
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:8090
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HAMYAR_MEDIA_GATEWAY=enabled
LIVEKIT_INTERNAL_URL=http://localhost:7880
# Configure a private production auth key via the environment; never reuse test fixtures.
# Recording worker will use private S3-compatible object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
