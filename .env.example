# Demo runs without external services. Copy this file to .env.local for development.
APP_URL=http://localhost:3000
# Credentials below are ONLY for the localhost development compose stack.
DATABASE_URL=postgresql://hamyar_app:hamyar_local_only@localhost:5432/hamyar
MIGRATION_DATABASE_URL=postgresql://hamyar:hamyar_local_only@localhost:5432/hamyar
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Configure a private production auth key via the environment; never reuse test fixtures.
# Recording worker will use private S3-compatible object storage.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
