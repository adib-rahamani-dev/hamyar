# Same API key/secret as private/livekit.yaml and private/runtime.env.
# Runtime app role ONLY. Loopback is published by the dedicated compose PostgreSQL service.
DATABASE_URL=postgresql://hamyar_app:REPLACE_APP_PASSWORD@127.0.0.1:55432/hamyar
BETTER_AUTH_URL=https://app.hamyar.example
AUTH_EMAIL_VERIFICATION_REQUIRED=false
HAMYAR_DEPLOYMENT_MODE=normal
HAMYAR_DOMESTIC_HOSTS=localhost,127.0.0.1
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_GATEWAY_PORT=8090
