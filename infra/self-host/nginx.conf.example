# Include inside nginx's http context, after installing valid certificates locally.
# Replace all hostnames/certificate paths. No automatic external ACME at runtime.
map $http_upgrade $hamyar_connection { default upgrade; '' close; }
server {
    listen 443 ssl;
    server_name app.hamyar.example;
    ssl_certificate /etc/hamyar/tls/fullchain.pem;
    ssl_certificate_key /etc/hamyar/tls/privkey.pem;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
server {
    listen 443 ssl;
    server_name media.hamyar.example;
    ssl_certificate /etc/hamyar/tls/fullchain.pem;
    ssl_certificate_key /etc/hamyar/tls/privkey.pem;
    # Signaling URLs contain short-lived bearer tokens. Never log them.
    access_log off;
    location ~ ^/rtc(/validate|/v1)?$ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hamyar_connection;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 90s;
    }
    location / { return 404; }
}
