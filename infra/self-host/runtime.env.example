# Copy into private/runtime.env. Replace every placeholder before starting.
# Percent-encode the app password in the connection URL.
DATABASE_URL=postgresql://hamyar_app:REPLACE_APP_PASSWORD@postgres:5432/hamyar
BETTER_AUTH_URL=https://app.hamyar.example
BETTER_AUTH_SECRET=
AUTH_EMAIL_VERIFICATION_REQUIRED=false
# This temporary account mode has no email recovery or unverified email invitations.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# These are credentials of YOUR LiveKit server, not LiveKit Cloud.
LIVEKIT_URL=wss://media.hamyar.example
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
