{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": ".gateway",
    "rootDir": "src/modules",
    "esModuleInterop": true
  },
  "include": [
    "src/modules/media/gateway-policy.ts",
    "src/modules/rooms/policy.ts",
    "src/modules/identity/database-role.ts",
    "src/modules/operations/deployment-mode.ts"
  ]
}
